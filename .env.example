# ── Better Auth ───────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Stores Better Auth `user`/`session` collections and app `services`/`transactions`.
BETTER_AUTH_DB_URI=mongodb://127.0.0.1:27017
BETTER_AUTH_DB_NAME=wedplandb

# ── Backend JWT (MUST match wedplan-server/.env) ──────────────────────────────
JWT_SECRET=replace-with-the-same-long-random-secret-used-by-the-server
JWT_EXPIRES_IN=15m
BACKEND_TOKEN_COOKIE_SECURE=false
BACKEND_TOKEN_COOKIE_SAME_SITE=lax
# Set COOKIE_SECURE=true and SAME_SITE=None only when client and API are on different secure sites.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# ── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Admin sign-up protection ─────────────────────────────────────────────────
# Leave empty only for local demos. Set a strong code before production.
ADMIN_SIGNUP_CODE=

# ── Image hosting ────────────────────────────────────────────────────────────
# ImgBB uploads happen in the browser, so this key is public by design.
NEXT_PUBLIC_IMGBB_API_KEY=

# ── Stripe Checkout (test mode) ──────────────────────────────────────────────
# Keep all STRIPE_* values server-side; never expose them with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PREMIUM_PRICE_ID=price_replace_me

# Webhook endpoint for local testing:
# stripe listen --forward-to localhost:3000/api/payments/webhook
# Use the printed whsec_ value for STRIPE_WEBHOOK_SECRET.
